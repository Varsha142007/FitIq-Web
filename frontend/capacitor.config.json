{
  "appId": "com.fitiq.app",
  "appName": "FitIQ",
  "webDir": "build",
  "bundledWebRuntime": false,
  "android": {
    "backgroundColor": "#FAF7F2",
    "captureInput": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#FAF7F2",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
